{
  "name": "spec-forge",
  "version": "1.0.0",
  "description": "An interview-first spec generator. A guided interview that adapts to your answers, then assembles proposal.md, design.md and tasks.md. Angular 20, fully client-side, no backend and no API key. The interview is live; generation is in progress.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run typecheck && ng build",
    "typecheck": "tsc --noEmit",
    "test": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "test:watch": "ng test",
    "eval:readability": "node evals/readability/run.mjs",
    "eval:readability:score": "node evals/readability/run.mjs --score",
    "prepare": "husky install"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/view": "^6.26.0",
    "codemirror": "^6.0.0",
    "fflate": "^0.8.1",
    "idb": "^8.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "^5.1.0",
    "@types/node": "^20.0.0",
    "husky": "^9.0.0",
    "jasmine-core": "^5.2.0",
    "karma": "^6.4.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.0",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "typescript": "^5.7.0"
  }
}
