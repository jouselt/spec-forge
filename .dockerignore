# Keep the Docker build context small: only what the image actually needs.
# Anything not required to run `npm ci` and `npm run build` stays out.

# Version control and CI
.git
.gitignore
.github

# Dependencies and build output, rebuilt inside the image
node_modules
dist
.angular
coverage
*.tsbuildinfo

# Local runtime state and logs
.atl
*.log
logs

# Environment files. The app needs no secrets, and none should reach an image.
.env
.env.*
!.env.example

# Local planning and personal files
odd
resume.md

# Editor, OS, docs
.vscode
.idea
.DS_Store
Thumbs.db
*.md
!README.md
